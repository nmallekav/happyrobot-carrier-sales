# Legacy TMS (TCP socket)
TMS_HOST=
TMS_PORT=
TMS_AUTH_TOKEN=

# FMCSA API
FMCSA_API_KEY=

# Backend API key (callers send it in the X-API-Key header)
API_KEY=

# FMCSA mock (FMCSA blocks non-US IPs). FMCSA_MOCK=true skips the real API.
# FMCSA_MOCK_ELIGIBLE=true -> mock carrier passes, false -> mock carrier is blocked.
FMCSA_MOCK=true
FMCSA_MOCK_ELIGIBLE=true
